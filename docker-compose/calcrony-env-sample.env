# Copy to Z:/docker/calcrony/.env (or your stack folder) and fill in real values.
# Run a second copy of the stack (e.g. test-calcrony) with its own .env and
# DISCORD_* values to keep prod and test bots fully isolated.

# Pin a release tag for production (e.g. 0.17.2); use main (published on every merge) only on a test stack.
CALCRONY_IMAGE_TAG=pin-a-release-tag-here

# Ports / URLs
CALCRONY_API_PORT=8100
CALCRONY_WEB_PORT=8101
CALCRONY_PUBLIC_BASE_URL=https://calcrony-api.your-sample-domain-name.dev
CALCRONY_WEB_ORIGIN=https://calcrony.your-sample-domain-name.dev

# Database
CALCRONY_DB_NAME=calcrony
CALCRONY_DB_USER=calcrony
CALCRONY_DB_PASSWORD=change_me

# Secrets
CALCRONY_API_KEY=generate_a_long_random_string_here
CALCRONY_JWT_SIGNING_KEY=generate_a_long_random_string_here

# Google Calendar OAuth
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_TEST_GUILD_ID=
DISCORD_APP_ID=your_discord_application_id
DISCORD_OAUTH_CLIENT_ID=your_discord_oauth_client_id
DISCORD_OAUTH_CLIENT_SECRET=your_discord_oauth_client_secret
