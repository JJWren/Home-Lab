# Global values shared by every stack. Each stack also has its own
# per-stack sample (arrs-env-sample.env, exposed-env-sample.env,
# media-env-sample.env, utilities-env-sample.env, calcrony-env-sample.env)
# listing every variable that stack's compose file references.
# Copy the relevant sample to <stack-folder>/.env and fill in real values.

# GLOBAL SETTINGS
PUID=1000 # sample user id, change to match your host user id
PGID=1000 # sample group id, change to match your host group id
TZ=America/Chicago # sample timezone, change to match your timezone

# PATHS (Host-specific)
PATH_CONFIG=Z:/docker # sample path to store config files, change to match your host setup
PATH_MEDIA=M:/media # sample path to media files, change to match your host setup
PATH_DOWNLOADS=M:/data/downloads # sample path to downloads, change to match your host setup

# DOMAIN
DOMAIN_NAME=your-sample-domain-name.dev
