# Copy to Z:/docker/media-server/.env (or your stack folder) and fill in real values.

# General System
PUID=1000
PGID=1000
TZ=America/Chicago

# App Ports (Plex defaults)
PLEX_WEBUI_PORT=32400
PLEX_DLNA_PORT=1900
PLEX_DLNA_DISC_PORT=32469
PLEX_COMPANION_PORT=3005
PLEX_ROKU_PORT=8324
PLEX_GDM1_PORT=32410
PLEX_GDM2_PORT=32412
PLEX_GDM3_PORT=32413
PLEX_GDM4_PORT=32414

# Plex Settings
MY_IPV4=192.168.1.100
PLEX_DIRECT_CONNECT=https://your-plex-direct-url:32400
