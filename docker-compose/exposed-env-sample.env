# Copy to Z:/docker/exposed-services/.env (or your stack folder) and fill in real values.

# General System
PUID=1000
PGID=1000
TZ=America/Chicago
DOMAIN_NAME=your-sample-domain-name.dev

# External Ports (shared with the reverse proxy)
EXTERNAL_WEB_PORT=80
EXTERNAL_SECURE_PORT=443

# --- FairShare ---
AdminSeed__User=admin
AdminSeed__Password=change_me
ADMIN_SEED_ENABLED=true
ADMIN_SEED_LOG_GENERATED_PASSWORD=true
ALLOW_SELF_REGISTRATION=false
FAIRSHARE_JWT_SIGNING_KEY=generate_a_long_random_string_here
FAIRSHARE_WEB_ORIGIN=https://fairshare.your-sample-domain-name.dev
FAIRSHARE_API_BASE_URL=https://fairshare-api.your-sample-domain-name.dev

# --- Komf (Komga/Kavita metadata) ---
KOMF_KOMGA_USER=your_komga_login
KOMF_KOMGA_PASSWORD=your_komga_password
KOMF_KAVITA_API_KEY=your_kavita_api_key

# App Ports
ABS_PORT=13378
ACTUAL_PORT=5006
FAIRSHARE_PORT=8090
FAIRSHARE_API_PORT=8091
KAVITA_PORT=5000
KOMGA_PORT=25600
KOMF_PORT=8085
MEALIE_PORT=9925
SEERR_PORT=5055
TAUTULLI_PORT=8181
WIZARR_PORT=5690
