# Copy to Z:/docker/arrs/.env (or your stack folder) and fill in real values.

# General System
PUID=1000
PGID=1000
TZ=America/Chicago

# --- Gluetun / VPN Settings (ProtonVPN + Wireguard shown) ---
VPN_SERVICE=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
WIREGUARD_ADDRESS=10.2.0.2/32

# App Ports (defaults shown; change if you remap)
QBIT_WEBUI_PORT=8080
QBIT_UDP_PORT=6881
PROWL_PORT=9696
RAD_PORT=7878
SON_PORT=8989
LID_PORT=8686
READ_PORT=8787
BAZ_PORT=6767
FLARE_PORT=8191
NOTIFI_PORT=5454
TD_UI_PORT=8265
TD_SERVER_PORT=8266
TD_NODE_PORT=8267
TD_XTRA_NODE_PORT=8268

# --- NZBGet Credentials ---
NZBGET_USER=your_nzbget_user
NZBGET_PASS=your_nzbget_password

# --- Notifiarr Secrets ---
NOTIFI_API=your_notifiarr_api_key
NOTIFI_PASS=your_notifiarr_ui_password
